{
  "name": "@wpiyaphon/gm-poc-package",
  "version": "1.2.6",
  "description": "A CLI to add customizable React components to your project",
  "bin": {
    "hongcn": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "templates"
  ],
