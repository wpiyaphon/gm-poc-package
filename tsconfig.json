{
    "compilerOptions": {
        "jsx": "react-jsx",
        "lib": [
            "ESNext",
            "DOM"
        ],
        "target": "ES2019",
        "module": "ESNext",
        "outDir": "dist",
        "moduleResolution": "Node",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": [
        "src"
    ]
}